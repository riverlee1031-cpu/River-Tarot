# Server-only: never put an API key in app.js or public config.
OPENAI_API_KEY=
# Use a Responses API model with Structured Outputs, available to your project.
OPENAI_MODEL=gpt-6-astra
PORT=3000
# Required in production. Comma-separated origins; no trailing path or slash.
ALLOWED_ORIGINS=http://localhost:3000
MAX_DAILY_READINGS=100

